QMainWindow, QDialog, QMessageBox {
    background-color: #0b0d12;
    color: #f4f5f7;
}
QWidget#Root {
    background-color: #0b0d12;
}
QLabel {
    background-color: transparent;
    color: #e8eaef;
}
QScrollArea#PageScroll, QScrollArea#PageScroll > QWidget > QWidget {
    background-color: transparent;
}
QLabel#SectionTitle {
    color: #a79bff;
    font-weight: 700;
    padding-top: 4px;
}
QFrame#PeriodStrip {
    background-color: #14161f;
    border: 1px solid #2a2d3a;
    border-radius: 12px;
}
QLabel#PeriodBadge {
    background-color: #6d5efc;
    color: #ffffff;
    border-radius: 8px;
    padding: 4px 10px;
    font-weight: 700;
}
QLabel#PeriodText { color: #d5d7e0; }
QFrame#Card[accent="purple"] { border-left: 4px solid #6d5efc; }
QFrame#Card[accent="green"] { border-left: 4px solid #34d399; }
QFrame#Card[accent="gold"] { border-left: 4px solid #f5c84c; }
QFrame#Card[accent="red"] { border-left: 4px solid #f87171; }
QLabel#CardValue[warn="true"] { color: #f87171; }
QLabel#WarnText { color: #fbbf24; }
QGroupBox {
    color: #d5d7e0;
    border: 1px solid #22252f;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #a79bff; }
QLabel#BrandMark {
    background-color: #6d5efc;
    color: #ffffff;
    border-radius: 12px;
}
QLabel#BrandTitle {
    color: #ffffff;
}
QLabel#BrandSub, QLabel#UserRole {
    color: #8b8e9a;
}
QFrame#AppHeader {
    background-color: #0e1018;
    border: none;
    border-bottom: 1px solid #1c1f2a;
}
QWidget#TopNavBar {
    background-color: transparent;
}
QPushButton#TopNav {
    background-color: #14161f;
    color: #d5d7e0;
    border: 1px solid #22252f;
    border-radius: 8px;
    padding: 3px 10px;
    min-height: 26px;
}
QPushButton#TopNav:hover {
    background-color: #1a1d28;
    color: #ffffff;
}
QPushButton#TopNav:checked {
    background-color: #6d5efc;
    color: #ffffff;
    border: 1px solid #6d5efc;
}
QPushButton#LogoutBtn {
    background-color: #1a1418;
    color: #f0a8b4;
    border: 1px solid #2a1c22;
    border-radius: 10px;
    padding: 6px 12px;
}
QPushButton#LogoutBtn:hover { background-color: #24181c; }
QFrame#ContentShell {
    background-color: #0b0d12;
    border: none;
}
QPushButton#IconBtn {
    background-color: #14161f;
    color: #d5d7e0;
    border: 1px solid #22252f;
    border-radius: 10px;
    padding: 6px 10px;
    min-width: 36px;
}
QPushButton#IconBtn:hover { background-color: #1a1d28; }
QLabel#UserAvatar {
    background-color: #f5c84c;
    color: #1a1400;
    border-radius: 16px;
}
QPushButton#Chip {
    background-color: #6d5efc;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 6px 12px;
}
QPushButton#Chip:hover { background-color: #5b4ee8; }
QPushButton#ChipGold {
    background-color: #f5c84c;
    color: #1a1400;
    border: none;
    border-radius: 14px;
    padding: 6px 12px;
}
QPushButton#ChipGold:hover { background-color: #f8d56a; }
QLabel#PageHeading {
    color: #ffffff;
}
QPushButton {
    background-color: #6d5efc;
    color: #ffffff;
    border: none;
    padding: 6px 12px;
    border-radius: 10px;
    min-height: 32px;
}
QPushButton:hover { background-color: #5b4ee8; }
QPushButton:disabled { background-color: #2a2d3a; color: #6b6f7c; }
QPushButton#GoldBtn {
    background-color: #f5c84c;
    color: #1a1400;
    padding: 8px 14px;
    border-radius: 12px;
}
QPushButton#GoldBtn:hover { background-color: #f8d56a; }
QPushButton#DarkBtn {
    background-color: #6d5efc;
    color: #ffffff;
    padding: 8px 14px;
    border-radius: 12px;
}
QPushButton#GhostBtn {
    background-color: #181b25;
    color: #d5d7e0;
    border: 1px solid #2a2d3a;
}
QPushButton#GhostBtn:hover { background-color: #22252f; }
QPushButton#DangerBtn {
    background-color: #3a1418;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
}
QPushButton#DangerBtn:hover { background-color: #4c1a20; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #14161f;
    border: 1px solid #2a2d3a;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 28px;
    color: #f4f5f7;
    selection-background-color: #6d5efc;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #6d5efc;
}
QComboBox QAbstractItemView {
    background-color: #14161f;
    color: #f4f5f7;
    border: 1px solid #2a2d3a;
    selection-background-color: #6d5efc;
}
QComboBox::drop-down { border: none; width: 22px; }
QLineEdit#PosSearch {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 12px;
}
QListWidget {
    background-color: #14161f;
    border: 1px solid #22252f;
    border-radius: 12px;
    padding: 4px;
    color: #f4f5f7;
}
QListWidget#PosResults::item {
    padding: 8px 10px;
    border-radius: 8px;
}
QListWidget::item:selected, QListWidget::item:hover {
    background-color: #1e2130;
    color: #ffffff;
}
QTableWidget {
    background-color: #10121a;
    gridline-color: transparent;
    border: 1px solid #1c1f2a;
    border-radius: 12px;
    alternate-background-color: #14161f;
    color: #e8eaef;
}
QHeaderView::section {
    background-color: #10121a;
    color: #8b8e9a;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #22252f;
}
QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1a1c24;
}
QTableWidget::item:selected {
    background-color: #1e2130;
    color: #ffffff;
}
QTableCornerButton::section {
    background-color: #10121a;
    border: none;
}
QTabWidget::pane {
    border: 1px solid #22252f;
    background-color: #10121a;
    border-radius: 12px;
}
QTabBar::tab {
    background-color: #14161f;
    color: #8b8e9a;
    padding: 8px 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background-color: #6d5efc;
    color: #ffffff;
}
QFrame#Card {
    background-color: #14161f;
    border: 1px solid #22252f;
    border-radius: 16px;
}
QFrame#Card:hover {
    border: 1px solid #6d5efc;
    background-color: #181b28;
}
QLabel#CardTitle { color: #8b8e9a; }
QLabel#CardValue { color: #ffffff; }
QFrame#PosLeft, QFrame#PosRight {
    background-color: #10121a;
    border: 1px solid #1c1f2a;
    border-radius: 16px;
}
QFrame#CustomerBar {
    background-color: #14161f;
    border-bottom: 1px solid #22252f;
}
QFrame#CartHeader {
    background-color: #14161f;
    border-bottom: 1px solid #22252f;
}
QLabel#CartHeaderText { color: #ffffff; }
QLabel#CartCount {
    background-color: #f5c84c;
    color: #1a1400;
    border-radius: 10px;
    padding: 4px 10px;
}
QFrame#ProductCard {
    background-color: #14161f;
    border: 1px solid #22252f;
    border-radius: 14px;
}
QLabel#ProductName { color: #ffffff; }
QLabel#ProductMeta { color: #8b8e9a; }
QFrame#PriceSlot {
    background-color: #10121a;
    border: 1px solid #2a2d3a;
    border-radius: 10px;
}
QLabel#EmptyHint { color: #6b6f7c; }
QFrame#TotalsBar {
    background-color: #14161f;
    border: 1px solid #22252f;
    border-radius: 12px;
}
QLabel#TotalPill {
    background-color: #f5c84c;
    color: #1a1400;
    border-radius: 10px;
    padding: 6px 10px;
}
QLabel#MoneyText { color: #ffffff; }
QLabel#Muted { color: #8b8e9a; }
QCheckBox, QRadioButton { color: #d5d7e0; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #2a2d3a;
    background-color: #14161f;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #6d5efc;
    border: 1px solid #6d5efc;
}
QDialogButtonBox QPushButton { min-width: 88px; }
QCalendarWidget QWidget { background-color: #14161f; color: #f4f5f7; }
QCalendarWidget QAbstractItemView {
    background-color: #14161f;
    color: #f4f5f7;
    selection-background-color: #6d5efc;
}
QToolTip {
    background-color: #181b25;
    color: #f4f5f7;
    border: 1px solid #2a2d3a;
    padding: 6px 8px;
}
QScrollBar:vertical {
    background-color: #0e1018;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #2a2d3a;
    min-height: 24px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: #0e1018;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #2a2d3a;
    min-width: 24px;
    border-radius: 5px;
}
QScrollArea { background-color: transparent; border: none; }
QTextBrowser {
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #22252f;
    border-radius: 12px;
    padding: 8px;
}
QMenu {
    background-color: #14161f;
    color: #f4f5f7;
    border: 1px solid #22252f;
}
QMenu::item:selected { background-color: #6d5efc; }
